Options -Indexes -ExecCGI
SetHandler default-handler

RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .php82 .php83 .phtml .phar .cgi .pl .py .sh .asp .aspx .jsp
RemoveType .php .php3 .php4 .php5 .php7 .php8 .php82 .php83 .phtml .phar .cgi .pl .py .sh .asp .aspx .jsp

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(php[0-9]*|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp|exe|bat|cmd)$">
        Require all denied
    </FilesMatch>
    <Files ".htaccess">
        Require all denied
    </Files>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)\.(php[0-9]*|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp|exe|bat|cmd)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <Files ".htaccess">
        Order allow,deny
        Deny from all
    </Files>
</IfModule>
